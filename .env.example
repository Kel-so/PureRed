# Copy to .env (never commit it) and fill in. Every script in scripts/ reads this file.

# --- Backblaze B2 -------------------------------------------------------------
# Master key (only for scripts/b2-setup.sh — delete it from here once setup is done)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=purered-media

# --- Cloudflare ---------------------------------------------------------------
CF_API_TOKEN=
CF_ZONE_ID=
# Hostname that will serve the videos, e.g. media.yourdomain.com
MEDIA_HOST=
# B2 download host, printed by scripts/b2-setup.sh, e.g. f004.backblazeb2.com
B2_DOWNLOAD_HOST=

# --- Optional -----------------------------------------------------------------
# FFMPEG=/path/to/ffmpeg
# FFPROBE=/path/to/ffprobe
